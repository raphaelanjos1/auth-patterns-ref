{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": "..",
  "testMatch": ["<rootDir>/test/**/*.e2e-spec.ts"],
  "testEnvironment": "node",
  "setupFiles": ["<rootDir>/test/setup-e2e.ts"],
  "transform": {
    "^.+\\.(t|j)s$": [
      "ts-jest",
      {
        "tsconfig": "<rootDir>/tsconfig.spec.json"
      }
    ]
  },
  "moduleNameMapper": {
    "^@generated/prisma$": "<rootDir>/generated/prisma/enums",
    "^.*/database/prisma\\.service$": "<rootDir>/src/__mocks__/prisma.service.ts",
    "^\\.\\/prisma\\.service$": "<rootDir>/src/__mocks__/prisma.service.ts"
  }
}
